    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "pg": "^8.16.3",
    "prisma": "^6.19.3",
    "swagger-ui-express": "^5.0.1"
  },
